/* CHEMISTRY AUTOCORRECT VERSION 1.0 - 14. feb 2022 by Niels.

INTRODUCTION:
Since it is rarely intended to write co2, I decided to write a list of autocorrects using unicode-symbols. Once installed - it is effortless.
Autocorrect is a powerful tool, and I decided to include some extra features that can be advantageous, if you get used to it.

-----------------------------
What is included in this script:
----- CHEMISTRY FORMULA AUTOCORRECT --------------
type any chemistry formula and it will be autocorrected
EXAMPLES:
Type: Bacl2 and it should be automated into BaCl₂ after you press the spacebar.
Type: pb(ch3coo)2*3h2o or alternatively just pbch3coo23h2o and it will be corrected into Pb(CH₃COO)₂∙3H₂O.

NOTE1:

If the formula only contains 2 characters like (H₂ and F⁻) you should end with a "!" and a space. (Made to prevent
Type h2! or f-! and it will correct into H₂ and F⁻

NOTE2:
If you type nacl the script will NOT correct it into NaCl, since this formula does not contain lowercase number nor charge.

NOTE3:
If you have a text with wrong formulas written by someone else, you can select the text with the formulas. Once selected press Shift+WinKey+q, and all the formulas should correct themself. If you find the hotkey annoying you can change the hotkey by editing this script (it is located around line 92).
--------------------------------------------------


----- LOOKUP ENGLISH NAMES ----------------
End any chemistry formula with a # to find the name for the formula
EXAMPLE nacl# will become sodium chloride or bacl2# will become barium chloride
--------------------------------------------------


----- CALL DOWN THE MOLAR MASS ----------------
type any chemistryformula and end with "m#"
EXAMPLE
naclm# will become: M(NaCl) = 58,44 g/mol or bacl2m# will become: .
--------------------------------------------------


-----SYMBOLS; KONSTANTS, OTHER--------------------------
In this script it is possible to write single lower/uppercase (see examples).
Some symbols are somewhat useful as a scientist. With this script I made some shortcuts:
EXAMPLES:
	<-> for equlibrium arrow ⇌
	<=> for ⇔
	--> for ⟶
	_[number between 1-30]! for lower case number. Fx _9! for ₉
	^[number between 1-30]! for upper case number. Fx ^9! for ⁹ or ^+! for ⁺
	and more (look in the script - roughly at line 7100)

Type !! for scientic constants. It can be a good idea to remember the shortcut for those you regular use:
i use r!! often
--------------------------------------------------

I might include those in a future version

*/
#SingleInstance, Force
SendMode, Input
;#NoEnv  ; Recommended for performance and compatibility with future AutoHotkey releases.
;#Warn  ; Enable warnings to assist with detecting common errors.

;------------------------- THANKS TO REDDIT-USER "NUJ" FOR HELPING OUT WITH THE CODING------------------------------------
; this part needs to be in the AutoExecute Section of your script (aka the top of your script)
SetWorkingDir, % A_ScriptDir

; Read the script into file:
FileRead, vFile, %A_ScriptName%

; remove all potential comments
; remove everything after the `;`
vFile := RegexReplace(vFile, "m)(^\s*|\s+)(\;)(.*)$")

; remove all comment blocks: \*   */
vFile := RegexReplace(vFile, "ms)^\s*/\*(.*?)\s*\*/")

; scan the script, line by line, for *exactly* the pattern:
oHotstrings_No_Options := {}
; ::hotstring::replacement
for index, line in StrSplit(vFile, "`n", "`r")
{
    If !RegExMatch(line, "Om)^\s*::(.*?)[\!]?::(.*?)$", oMatch)
        continue

    ; save matched hotstring pattern into
    oHotstrings_No_Options[oMatch[1]] := oMatch[2]
}
return
; end of auto-execute section

+#Q:: ; <-------------- This will target the hotkey to shift+winkey+q

oldClip := clipboardAll
    clipboard := ""

    ; copies the text
    send ^c
    Clipwait, 0.25
	if ErrorLevel ; if nothing is highlighted.
	{
	KeyWait, LShift ; waits for SHIFT to be released

		; send ^+{Left} to select everything to the left of the cursor.
		Send, {LCtrl down}{LShift down}
		Send, {Left}
		Send, {LShift up}{LCtrl up}

		; copy it to clipboard
		Send ^c
		clipwait, 2
		sleep, 100
		sleep, -1
		vVar := clipboard
		;FirstChar := SubStr(vVar, 1,1)
		if (vVar = "+" or vVar = "−" or vVar = "-" or vVar ="!")
		{	Send, {LCtrl down}{LShift down}
			Send, {Left}
			Send, {LShift up}{LCtrl up}
			Send ^c
			clipwait, 2
			sleep, 100
			sleep, -1
			vVar := clipboard
		}
		vVar := RegExReplace(vVar, "\b−", "-")

		clipboard := oldClip

		if !(oHotstrings_No_Options[vVar])
		{	Send, {Right}
			return
		}

		else
		{
			vCurrent_SendLevel := A_SendLevel
			; allows AHK to trigger hotstrings
			SendLevel, 2

			; manually type in the word to trigger the hotstring
			SendRaw, % vVar

			; send space to trigger hotstring
			Send, {space}

			; reset your sendLevel back to normal
			SendLevel, % vCurrent_SendLevel
			sleep, 50

			; deletes the extra space
			send, {backspace}
			return
		}
	}
	Clipwait, 5
    Sleep, 50
    sleep, -1
    vVar := Clipboard
	;____________ This script struggles in MSWord. This is some jam, but it didnt solve the problem.
	;~ StringReplace, Hotstring, Clipboard, ``, ````, All  ; Do this replacement first to avoid interfering with the others below.
    ;~ StringReplace, Hotstring, Hotstring, `r`n, ``r, All  ; Using `r works better than `n in MS Word, etc.
    ;~ StringReplace, Hotstring, Hotstring, `n, ``r, All
    ;~ StringReplace, Hotstring, Hotstring, %A_Tab%, ``t, All
    ;~ StringReplace, Hotstring, Hotstring, `;, ```;, All

	;____________
    Clipboard := ""
	;____________ For space between formula and state of matter.
	;~ vVar := RegExReplace(vVar, "i)\b(\((aq|l|s|g)\))", " $1") ; remove all state of matters written directly behind a word
	;~ vVar := RegExReplace(vVar, "i)(\-|\⁻)(\((aq|l|s|g)\))", "$1 $2")
	;____________
	-------
	vVar := RegExReplace(vVar, "i)\b[−]", "-")


	; replaces all "hotstrings" with their "replacement"
    ; Explanation:
	; (?<!\*)   : This will stop the Regex from triggering cuso4*5h2o into CuSO₄*5H₂O
	; ([0-9]+)?	: These are the coefficents. These can be avoided. I included them because I prefer a space between them
	; (?!-|\*)	: If - is permitted, the o2- might correct into O₂-. The * is to prevent cuso4*5h2o into CuSO₄*5H2O
	for hKey, replacement in oHotstrings_No_Options
	{
		if SubStr(hKey, 1, 1) = "(" ; In case of (NH4)2SO4 etc
			vVar := RegExReplace(vVar, "i)\B(?<!\*)([0-9]+)?\Q" hKey "\E(?!\*)\b","$1"replacement)

		else if (SubStr(hKey, 0) = "+" or SubStr(hKey, 0) = "-") ; This will trigger on ions
			vVar := RegExReplace(vVar, "i)\b(?<!\*)([0-9]+)?\Q" hKey "\E(?!\*)\B","$1"replacement)
		else
			vVar := RegExReplace(vVar, "i)\b(?<!\*)([0-9]+)?\Q" hKey "\E(?!-|\*)\b","$1"replacement)
	}
	Sleep, 50
    clipboard := vVar
    Clipwait, 2
    Sleep, 500
    sleep, -1

    send ^v			; Alternativt send % vVar, but that gives additional spacing (?!).
    clipboard := oldClip
return
;-------------------------------------------------------------------------------------------------------
